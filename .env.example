APP_NAME="GestMedicert ERP Santé"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=lpc:.\GESTMEDICERT
DB_PORT=
DB_DATABASE=GestMedicertCommercial
DB_USERNAME=sa
DB_PASSWORD=
DB_POOLING=false
DB_MARS=false
DB_LOGIN_TIMEOUT=30
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

LEGACY_DB_HOST=lpc:.\GESTMEDICERT
LEGACY_DB_PORT=
LEGACY_DB_DATABASE=GestMedicert
LEGACY_DB_USERNAME=sa
LEGACY_DB_PASSWORD=
LEGACY_DB_POOLING=false
LEGACY_DB_MARS=false
LEGACY_DB_LOGIN_TIMEOUT=30
LEGACY_DB_ENCRYPT=yes
LEGACY_DB_TRUST_SERVER_CERTIFICATE=true
LEGACY_FILES_ROOT=C:\xampp\htdocs\GestMedicert

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="gestmedicert@localhost"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
